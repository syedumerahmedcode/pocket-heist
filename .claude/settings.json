{
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(git init)",
      "Bash(git switch:*)",
      "Bash(git add .)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"hello\""
          },
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{require('fs').writeFileSync('tool-use.json',JSON.stringify(JSON.parse(d),null,2))})\""
          }
          ,
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{const j=JSON.parse(d);const fp=(j.tool_input||{}).file_path||'';if(/\\.tsx?$/.test(fp)){const {spawnSync}=require('child_process');spawnSync('npx',['prettier','--write',fp],{stdio:'inherit'});}})\" 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
